// The phone app's own look, made by Kosika Designs.
//
//   kosika run look.kos --workflow look --input look.json
//
// where look.json holds {"ask": {"seed": 137}}. app/build.sh runs it on
// every build: the app's colours are Designs' palettes (checked for
// contrast by Designs itself), and its pictures (the orb, the sky behind
// everything, the empty pages) are Designs' generative art, drawn by code.
// Every colour in them is a palette variable, so choosing another palette
// in the app repaints all of it, the drawings too.

import "std/designs_palette.kos"
import "std/designs_generative.kos"

export [LookAsk, Look, Swatch, look]

record LookAsk { seed: Number }
record Swatch { name: Text label: Text mood: Text bg: Text gold: Text think: Text accent: Text }
// css: the palettes and the art's motion. The rest are SVG, drawn by code.
record Look { css: Text swatches: Swatch[] problems: Text[] orb: Text sky: Text tree: Text bloom: Text waves: Text }

fn piece(name: Text, seed: Number, density: Number, mood: Text, title: Text) -> GenRecipe {
  return {piece: name, palette: "dark_matter", mood: mood, seed: seed, density: density, title: title}
}

fn swatch(p: Palette) -> Swatch {
  return {name: p.name, label: p.label, mood: p.mood, bg: p.bg, gold: p.gold, think: p.think, accent: p.accent}
}

// Only palettes a person can read on a phone: Designs checks each one's
// contrast, and Print (black on white, for paper) is left out.
fn usable() -> Palette[] {
  return for p in palettes() where p.name != "print" and palette_problems(p).is_empty() { p }
}

fn all_problems() -> Text[] {
  var out: Text[] = []
  for p in palettes() {
    if p.name != "print" { out = out.concat(palette_problems(p)) }
  }
  return out
}

workflow look(ask: LookAsk) -> Look {
  orb   = gen_svg(piece("orbits", ask.seed, 0.6, "lively", "Kosi"))
  sky   = gen_svg(piece("flow", ask.seed + 1, 0.15, "calm", "The sky behind Kosika"))
  tree  = gen_svg(piece("tree", ask.seed + 2, 0.5, "calm", "Your saved answers grow here"))
  bloom = gen_svg(piece("bloom", ask.seed + 3, 0.55, "calm", "Kosika Designs"))
  waves = gen_svg(piece("waves", ask.seed + 4, 0.5, "calm", "Agents"))
  out   = {css: palettes_css() + gen_style(), swatches: for p in usable() { swatch(p) }, problems: all_problems(), orb: orb, sky: sky, tree: tree, bloom: bloom, waves: waves}
}

test "the look's art is drawn in palette colours, so a new palette repaints it" {
  r = piece("orbits", 137, 0.6, "lively", "Kosi")
  expect gen_problems(r).is_empty()
  expect gen_svg(r).contains("var(--")
}

test "every palette offered on the phone is readable" {
  expect usable().length() >= 5
  expect all_problems().is_empty()
}
