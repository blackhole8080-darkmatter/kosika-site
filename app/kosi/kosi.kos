// Kosi on the phone: the one door every question goes through.
//
//   kosika test kosi.kos
//   kosika run kosi.kos --workflow route --input said.json
//   kosika run kosi.kos --workflow answer --input said.json --model NAME ...
//
// where said.json holds {"msg": {"text": "how does the heart pump blood"}}.
//
// `route` is plain code, so it works in airplane mode: it reads the words of
// the question and says who should take it (Kosi, a Designs drawing, the
// notebook, the router) and whether a picture would help. `answer` asks a
// model for a few plain sentences. `art` draws a piece of generative art
// chosen by code from the words, with no model at all. `screen` designs an
// interface (a phone app, a website, an agent's window) with Designs' ui
// kind; with no model, Kosika lays out a starter screen from the words.

import "std/designs.kos"
import "std/designs_generative.kos"
import "std/designs_ui.kos"

export [Msg, Said, Turn, Talk, KosiSaid, Known, Route, route, answer, known, forget, art, screen, picture_helps, art_recipe, facts_kept]

record Msg { text: Text }
record Said { text: Text }
// One turn of the conversation so far: what Aryan said, what Kosi said.
record Turn { q: Text a: Text }
// What Kosi is asked: the words, the turns before them (oldest first).
record Talk { text: Text earlier: Turn[] }
// The model writes three things. text: the answer. about: the question
// written so it makes sense on its own ("and why?" becomes "why is the sky
// blue?"), for Designs to draw. keep: one short thing worth remembering
// about Aryan, or nothing.
record KosiSaid { text: Text about: Text keep: Text }
record KosiBrief { task: Text question: Text earlier: Text known: Text }
// What Kosi knows about Aryan: short facts, newest last.
record Known { facts: Text[] }
// agent: who takes it. kind: how Designs would draw it. picture: whether
// to draw. offline: whether it can be done with no model at all.
record Route { agent: Text kind: Text picture: Bool offline: Bool why: Text }

model kosi {
  input: KosiBrief
  output: KosiSaid
  parameters: {
    max_output_tokens: 1200
  }
}

// Kosi remembers on the phone only, in its own memory folder.
memory me of Known

fn kosi_task() -> Text {
  return "You are Kosi, the friendly helper inside Kosika, talking with Aryan on his phone. KosiSaid in plain words: two to five short sentences, the most important idea first, no jargon left unexplained. If a picture would help, a picture is drawn beside your answer, so do not describe a picture. If you are not sure, say so. 'earlier' is the conversation so far: a short question like 'and why?' or 'what about Mars?' continues it. 'known' is what you remember about Aryan: use it when it helps, never recite it. Fill 'about' with the question written so it makes sense on its own. Fill 'keep' with one short fact about Aryan himself worth remembering for later (his studies, plans, likes, people, dates), in the third person, like 'Aryan has a physics exam on 12 December'; leave it empty when there is nothing new about him. Never keep passwords, keys or codes."
}

fn quiet() -> KosiSaid { return {text: "", about: "", keep: ""} }

// ---------------------------------------------------------------- the conversation

// The last few turns, as plain lines, newest last.
fn earlier_text(turns: Turn[]) -> Text {
  let start = (turns.length() - 6).max(0)
  var out = ""
  for i in start until turns.length() {
    out = out + "Aryan: " + cut(turns[i].q, 300) + "\nKosi: " + cut(turns[i].a, 500) + "\n"
  }
  return out
}

fn cut(text: Text, most: Number) -> Text {
  let t = text.trim()
  return if t.length() <= most { t } else { t.slice(0, most) + "…" }
}

fn known_text(k: Known) -> Text {
  return k.facts.join("\n")
}

fn no_facts() -> Known { let none: Text[] = [] return {facts: none} }

// ---------------------------------------------------------------- remembering

// Kosika decides what is kept, not the model: one short line, about
// Aryan, not a secret, not kept already. The newest 40 are kept.
fn keepable(fact: Text) -> Bool {
  let t = " " + fact.lower().trim() + " "
  if fact.trim().length() < 8 or fact.trim().length() > 160 { return false }
  if not t.contains("aryan") { return false }
  if has_any(t, ["password", "passcode", " pin ", "api key", " key is", "token", "secret", "sk-", "gsk_", "otp", "card number", "bank"]) { return false }
  return true
}

fn facts_kept(k: Known, fact: Text) -> Known {
  let f = fact.trim().trim_marks(".")
  if not keepable(f) { return k }
  for old in k.facts { if old.lower() == f.lower() { return k } }
  let all = k.facts.concat([f])
  let start = (all.length() - 40).max(0)
  return {facts: all.slice(start, all.length())}
}

fn facts_without(k: Known, fact: Text) -> Known {
  return {facts: for f in k.facts where f != fact { f }}
}

fn answered(said: KosiSaid, talk: Talk) -> KosiSaid {
  let about = if said.about.trim().is_empty() { talk.text } else { said.about.trim() }
  return {text: said.text.trim(), about: about, keep: if keepable(said.keep) { said.keep.trim() } else { "" }}
}

workflow answer(talk: Talk) -> KosiSaid {
  budget 2 model calls, 180 seconds
  mine  = recall me under "me"
  had   = known_of(mine)
  said  = use_model kosi(kosi_task(), talk.text, earlier_text(talk.earlier), known_text(had)) retry 1 otherwise quiet()
  made  = answered(said, talk)
  now   = facts_kept(had, made.keep)
  saved = remember now in me under "me"
  out   = kosi_same(made)
}

fn kosi_same(a: KosiSaid) -> KosiSaid { return a }

fn known_of(r: MeRecalled) -> Known { return r.value.or(no_facts()) }

// What Kosi remembers about Aryan, for Settings.
workflow known(msg: Msg) -> Known {
  mine = recall me under "me"
  out  = known_of(mine)
}

// Forget one thing, word for word.
workflow forget(msg: Msg) -> Known {
  mine  = recall me under "me"
  left  = facts_without(known_of(mine), msg.text)
  saved = remember left in me under "me"
  out   = kosi_still(left)
}

fn kosi_still(k: Known) -> Known { return k }

// ---------------------------------------------------------------- routing

fn padded(text: Text) -> Text { return " " + text.lower().trim().trim_marks("?!.") + " " }

fn has_any(t: Text, words: Text[]) -> Bool {
  for w in words {
    if t.contains(w) { return true }
  }
  return false
}

fn dz_for(text: Text) -> DzAsk { return {text: text, palette: "", place: "chat", kind: ""} }

// The kinds Kosika draws by itself, with no model.
fn offline_kinds() -> Text[] { return ["chemistry", "units", "element"] }

// A picture helps when the question asks how or why something works, asks
// to see something, or names a shape a drawing has. Small talk does not.
fn picture_helps(text: Text) -> Bool {
  let t = padded(text)
  if has_any(t, [" draw", " show me", " picture", " diagram", " visual", " illustrat", " animate", " map of", " timeline", " compare", " vs ", " versus ", " mind map", " art ", " wallpaper", " generative"]) { return true }
  if has_any(t, [" how does ", " how do ", " why does ", " why do ", " why is ", " why are ", " what happens ", " explain ", " what is inside", " structure of", " parts of", " steps "]) { return true }
  return false
}

fn route_for(text: Text) -> Route {
  let t = padded(text)
  let kind = dz_kind(dz_for(text))
  if t.starts_with(" remember") or t.starts_with(" note ") or t.starts_with(" note:") or has_any(t, [" what did i ", " do i have ", " my notes", " when is my ", " where did i ", " what do i pay"]) {
    return {agent: "notebook", kind: "", picture: false, offline: true, why: "you asked me to keep or find a note, so the notebook takes it"}
  }
  if has_any(t, [" from ashby", " to cove", " cheapest ", " fewest stops", " the network "]) {
    return {agent: "router", kind: "", picture: false, offline: true, why: "a journey on the rail network is found by A* search, exactly"}
  }
  if offline_kinds().contains(kind) {
    return {agent: "designs", kind: kind, picture: true, offline: true, why: dz_why(dz_for(text))}
  }
  if kind == "quiz" {
    return {agent: "designs", kind: kind, picture: true, offline: false, why: "you asked to be tested, so Designs makes a quiz"}
  }
  if kind == "ui" {
    return {agent: "designs", kind: kind, picture: true, offline: true, why: "you asked for a screen, so Designs lays it out in its ui style; with no model, Kosika lays out a starter from your words"}
  }
  if kind == "art" {
    return {agent: "designs", kind: kind, picture: true, offline: true, why: "you asked for art, so Designs makes a moving piece; with no model, Kosika chooses it from your words"}
  }
  let picture = picture_helps(text)
  let why = if picture { "a picture helps here, so Kosi answers and Designs draws it as " + kind } else { "Kosi answers in words" }
  return {agent: "kosi", kind: kind, picture: picture, offline: false, why: why}
}

workflow route(msg: Msg) -> Route {
  out = route_for(msg.text)
}

// ---------------------------------------------------------------- art with no model

fn art_recipe(text: Text) -> GenRecipe {
  let t = padded(text)
  let piece = if has_any(t, [" sea", " ocean", " water", " wave", " sound", " calm", " rain", " river"]) { "waves" } else if has_any(t, [" tree", " forest", " grow", " nature", " family", " leaf", " plant"]) { "tree" } else if has_any(t, [" space", " planet", " orbit", " atom", " star", " moon", " galaxy", " time"]) { "orbits" } else if has_any(t, [" fire", " wind", " flow", " energy", " thought", " storm", " electric"]) { "flow" } else { "bloom" }
  let palette = if has_any(t, [" sea", " ocean", " water", " rain", " river"]) { "ocean" } else if has_any(t, [" fire", " energy", " sun", " warm"]) { "ember" } else if has_any(t, [" tree", " forest", " nature", " leaf", " plant"]) { "forest" } else if has_any(t, [" night", " dream", " aurora", " sky"]) { "aurora" } else { "dark_matter" }
  let mood = if has_any(t, [" lively", " energy", " fast", " storm", " fire", " wild"]) { "lively" } else { "calm" }
  var seed = 7
  for c in t.chars() { seed = (seed * 31 + "abcdefghijklmnopqrstuvwxyz".index_of(c).or(13)) % 99991 }
  let words = text.trim()
  let title = if words.length() > 40 { words.slice(0, 40) } else { words }
  return {piece: piece, palette: palette, mood: mood, seed: seed, density: 0.6, title: title}
}

workflow art(msg: Msg) -> DzResult {
  made = call gen_render(art_recipe(msg.text))
  out  = dz_from_art_offline(msg.text, made)
}

// An interface with no model: Designs' starter screen for the words,
// checked and drawn by the same design system the model's designs use.
workflow screen(msg: Msg) -> DzResult {
  out = dz_from_ui_offline(msg.text, ui_result(screen_ask(msg.text), ui_starter(screen_ask(msg.text))))
}

fn screen_ask(text: Text) -> UiAsk { return {text: text, target: "", theme: "dark", accent: ""} }

fn dz_from_ui_offline(text: Text, r: UiResult) -> DzResult {
  return {kind: "ui", why: "laid out by Kosika from your words, with no model", title: r.title, page: r.page, svg: "", embed: "", problems: r.problems, fixed: r.fixed}
}

fn dz_from_art_offline(text: Text, g: GenArt) -> DzResult {
  let none: Text[] = []
  return {kind: "art", why: "drawn by code from your words, with no model", title: g.recipe.title, page: g.page, svg: g.svg, embed: "", problems: g.problems, fixed: none}
}

// ---------------------------------------------------------------- tests

test "small talk is answered in words, with no picture" {
  r = route_for("hi Kosi, how are you today")
  expect r.agent == "kosi"
  expect not r.picture
}

test "a how question gets a picture" {
  r = route_for("How does the heart pump blood?")
  expect r.agent == "kosi"
  expect r.picture
  expect r.kind == "canvas"
}

test "chemistry, units and elements are drawn with no model" {
  expect route_for("balance CH4 + O2 -> CO2 + H2O").offline
  expect route_for("convert 60 km/h to m/s").kind == "units"
  expect route_for("tell me about sodium").agent == "designs"
}

test "notes and journeys go to their agents" {
  expect route_for("remember: physics exam on 12 December").agent == "notebook"
  expect route_for("when is my physics exam?").agent == "notebook"
  expect route_for("from Ashby to Cove").agent == "router"
}

test "screens go to Designs' ui kind, and work with no model" {
  r = route_for("design a phone app for my study timetable")
  expect r.agent == "designs"
  expect r.kind == "ui"
  expect r.offline
  expect route_for("make a landing page for my coffee shop").kind == "ui"
  s = ui_result(screen_ask("a phone app for my study timetable"), ui_starter(screen_ask("a phone app for my study timetable")))
  expect s.target == "phone"
  expect s.problems.is_empty()
  expect s.page.contains("<svg")
}

fn talk_of(text: Text, q: Text, a: Text) -> Talk { return {text: text, earlier: [{q: q, a: a}]} }
fn said_of(text: Text, about: Text, keep: Text) -> KosiSaid { return {text: text, about: about, keep: keep} }

test "Kosi keeps short facts about Aryan, never secrets, never twice" {
  k = facts_kept(no_facts(), "Aryan has a physics exam on 12 December.")
  expect k.facts.length() == 1
  expect facts_kept(k, "aryan has a physics exam on 12 December").facts.length() == 1
  expect facts_kept(k, "Aryan's Groq api key is gsk_123").facts.length() == 1
  expect facts_kept(k, "The sky is blue").facts.length() == 1
  expect facts_without(k, "Aryan has a physics exam on 12 December").facts.is_empty()
}

test "the conversation so far is the last six turns" {
  t = talk_of("and why?", "is the sky blue", "Yes.")
  expect earlier_text(t.earlier).contains("Aryan: is the sky blue")
  expect answered(said_of(" It scatters. ", "", "Aryan's password is x"), t).about == "and why?"
  expect answered(said_of(" It scatters. ", "", "Aryan's password is x"), t).keep == ""
}

test "art is chosen from the words, the same every time" {
  a = art_recipe("a calm piece about the sea")
  expect a.piece == "waves"
  expect a.palette == "ocean"
  expect a.seed == art_recipe("a calm piece about the sea").seed
  expect gen_problems(a).is_empty()
}
